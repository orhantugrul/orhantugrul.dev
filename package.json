    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.6",
