{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orhantugrul-dev",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "preview_urls": true,
}
