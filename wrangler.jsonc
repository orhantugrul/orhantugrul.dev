{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orhantugrul",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [{ "pattern": "orhantugrul.dev", "custom_domain": true }],
  "routes": [
    {
      "pattern": "orhantugrul.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
}
